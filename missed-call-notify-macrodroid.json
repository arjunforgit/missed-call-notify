      "parameters": {
        "jsCode": "const now = new Date();\nconst istDateStr = now.toLocaleString(\"en-US\", { timeZone: \"Asia/Kolkata\" });\nconst ist = new Date(istDateStr);\n\nconst hour = ist.getHours();\nconst dayOfWeek = ist.getDay();\n\nconst isDayShift = hour >= 10 && hour < 22;\nconst isSundayNight = (dayOfWeek === 0) && (!isDayShift);\nconst currentShiftType = (isDayShift || isSundayNight) ? 'day' : 'night';\n\nconst ROTATION_START = new Date('2026-07-27T09:00:00+05:30');\nconst msPerWeek = 7 * 24 * 60 * 60 * 1000;\nconst weeksSinceStart = Math.floor((ist - ROTATION_START) / msPerWeek);\nconst weekParity = weeksSinceStart % 2 === 0 ? 'even' : 'odd';\n\nconst slot = `${weekParity}_${currentShiftType}`;\n\nreturn {\n  json: {\n    ...($input.item.json),\n    shift_slot: slot\n  }\n};"
